# Name of your SSH key in Hetzner Cloud (see: hcloud ssh-key list)
HCLOUD_SSH_KEY_NAME=my-key

# Path to the corresponding local private key
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# Hetzner Cloud API token (required for auto-delete watchdog)
# Generate at: https://console.hetzner.cloud/ -> Security -> API Tokens
HCLOUD_API_TOKEN=
