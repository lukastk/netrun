{
  "extra": {
    "description": "A basic example demonstrating netrun's flow-based execution"
  },
  "output_queues": {
    "results": {
      "ports": [
        [
          "format_result",
          "out"
        ]
      ]
    },
    "summaries": {
      "ports": [
        [
          "analyze",
          "summary"
        ]
      ]
    },
    "breakdowns": {
      "ports": [
        [
          "analyze",
          "breakdown"
        ]
      ]
    }
  },
  "graph": {
    "extra": {
      "ui": {
        "viewport": {
          "x": 0,
          "y": 0,
          "zoom": 1
        },
        "actions": [
          {
            "id": "action-show-info",
            "label": "Show Node Info",
            "command": "echo \"Node: $NODE_NAME\" && echo \"Project root: $PROJECT_ROOT\""
          },
          {
            "id": "action-run-project",
            "label": "Run Project",
            "command": "cd $PROJECT_ROOT && uv run python main.py"
          }
        ]
      }
    },
    "nodes": [
      {
        "name": "double",
        "factory": "netrun.node_factories.from_function",
        "factory_args": {
          "func": "nodes.double"
        },
        "extra": {
          "ui": {
            "position": {
              "x": 300,
              "y": 100
            }
          }
        }
      },
      {
        "name": "add",
        "factory": "netrun.node_factories.from_function",
        "factory_args": {
          "func": "nodes.add"
        },
        "extra": {
          "ui": {
            "position": {
              "x": 500,
              "y": 150
            }
          }
        }
      },
      {
        "name": "format_result",
        "factory": "netrun.node_factories.from_function",
        "factory_args": {
          "func": "nodes.format_result"
        },
        "extra": {
          "ui": {
            "position": {
              "x": 700,
              "y": 100
            }
          }
        }
      },
      {
        "name": "analyze",
        "factory": "netrun.node_factories.from_function",
        "factory_args": {
          "func": "nodes.analyze"
        },
        "extra": {
          "ui": {
            "position": {
              "x": 700,
              "y": 250
            },
            "actions": [
              {
                "id": "action-show-analysis",
                "label": "Show Analysis Ports",
                "command": "echo \"$NODE_NAME has output ports: summary, breakdown\""
              }
            ]
          }
        }
      }
    ],
    "edges": [
      {
        "source_node": "double",
        "source_port": "out",
        "target_node": "add",
        "target_port": "a"
      },
      {
        "source_node": "add",
        "source_port": "out",
        "target_node": "format_result",
        "target_port": "value"
      }
    ]
  }
}
