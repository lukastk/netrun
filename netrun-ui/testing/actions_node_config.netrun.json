{
  "meta": {
    "description": "Example demonstrating NODE_CONFIG action variable with jq",
    "ui": {
      "defaultCmd": "echo",
      "env": {
        "GREETING": "hello"
      },
      "actions": [
        {
          "id": "action-show-config",
          "label": "Show Node Config",
          "command": "echo $NODE_CONFIG | jq ."
        },
        {
          "id": "action-get-name",
          "label": "Get Node Name from Config",
          "command": "echo $NODE_CONFIG | jq -r .name"
        },
        {
          "id": "action-list-ports",
          "label": "List Input Ports",
          "command": "echo $NODE_CONFIG | jq -r '.inPorts | keys[]'"
        },
        {
          "id": "action-get-factory",
          "label": "Get Factory Path",
          "command": "echo $NODE_CONFIG | jq -r '.factory // \"no factory\"'"
        },
        {
          "id": "action-echo-name",
          "label": "Echo Node Name",
          "command": "$DEFAULT_CMD $NODE_NAME"
        }
      ]
    }
  },
  "project_root": ".",
  "graph": {
    "nodes": [
      {
        "name": "DataLoader",
        "factory": "netrun.node_factories.function",
        "factory_args": {
          "func": "json.loads"
        },
        "in_ports": {
          "data": {
            "port_type": "str"
          }
        },
        "out_ports": {
          "result": {
            "port_type": "dict"
          }
        },
        "meta": {
          "ui": {
            "id": "node-loader",
            "label": "DataLoader",
            "position": {
              "x": 100,
              "y": 100
            }
          }
        }
      },
      {
        "name": "Transformer",
        "in_ports": {
          "input": {
            "port_type": "dict"
          },
          "config": {
            "port_type": "dict"
          }
        },
        "out_ports": {
          "output": {
            "port_type": "dict"
          },
          "logs": {
            "port_type": "str"
          }
        },
        "meta": {
          "ui": {
            "id": "node-transform",
            "label": "Transformer",
            "position": {
              "x": 400,
              "y": 100
            }
          }
        }
      },
      {
        "name": "OutputSink",
        "in_ports": {
          "value": {
            "port_type": "any"
          }
        },
        "out_ports": {},
        "meta": {
          "ui": {
            "id": "node-sink",
            "label": "OutputSink",
            "position": {
              "x": 700,
              "y": 100
            }
          }
        }
      }
    ],
    "edges": [
      {
        "source_str": "DataLoader.result",
        "target_str": "Transformer.input"
      },
      {
        "source_str": "Transformer.output",
        "target_str": "OutputSink.value"
      }
    ]
  }
}
