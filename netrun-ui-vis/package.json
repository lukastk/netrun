{
	"name": "netrun-ui-vis",
	"version": "0.1.0",
	"type": "module",
	"svelte": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./components": {
			"types": "./src/components/index.ts",
			"svelte": "./src/components/index.ts",
			"default": "./src/components/index.ts"
		},
		"./theme.css": "./src/theme.css"
	},
	"bin": {
		"netrun-vis-export": "./bin/netrun-vis-export.mjs"
	},
	"files": [
		"src",
		"bin",
		"dist/app"
	],
	"scripts": {
		"build:app": "vite build --config app/vite.config.ts",
		"dev:app": "vite dev --config app/vite.config.ts",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"@xyflow/svelte": "^1.5.0"
	},
	"dependencies": {
		"elkjs": "^0.11.0"
	},
	"devDependencies": {
		"svelte": "^5.48.2",
		"@xyflow/svelte": "^1.5.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"vite": "^6.0.0",
		"typescript": "^5.9.3",
		"svelte-check": "^4.3.5"
	}
}
